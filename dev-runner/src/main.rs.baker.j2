use std::{
    error::Error,
    path::{Path, PathBuf},
    process::{ExitStatus, Stdio},
    time::Duration,
};

use testcontainers::{ContainerAsync, runners::AsyncRunner};
use testcontainers_modules::postgres::Postgres;
use tokio::{
    net::TcpStream,
    process::{Child, Command},
    time::sleep,
};

#[tokio::main]
async fn main() -> Result<(), Box<dyn Error>> {
    let with_frontend = std::env::args().any(|argument| argument == "--with-frontend");
    let package_name = "{{ project_name }}";
    let project_dir = Path::new(env!("CARGO_MANIFEST_DIR"))
        .parent()
        .expect("dev-runner must be inside the project workspace");
    let executable = backend_executable(project_dir, package_name).await?;
    let build_status = Command::new("cargo")
        .args(["build", "-p", package_name])
        .current_dir(project_dir)
        .status()
        .await?;
    if !build_status.success() {
        return Err(format!("backend build exited with {build_status}").into());
    }

    let database_name = "{{ project_name | snake_case }}_dev";
    let postgres: ContainerAsync<Postgres> = Postgres::default()
        .with_db_name(database_name)
        .with_user("postgres")
        .with_password("postgres")
        .start()
        .await?;

    let host = postgres.get_host().await?;
    let port = postgres.get_host_port_ipv4(5432).await?;
    let database_url = format!("postgres://postgres:postgres@{host}:{port}/{database_name}");
    eprintln!("Started dev PostgreSQL at {host}:{port}");

    let mut backend = Command::new(executable)
        .current_dir(project_dir)
        .env("DATABASE_URL", database_url)
        .stdin(Stdio::inherit())
        .stdout(Stdio::inherit())
        .stderr(Stdio::inherit())
        .spawn()?;

    let shutdown = tokio::signal::ctrl_c();
    tokio::pin!(shutdown);
    loop {
        tokio::select! {
            biased;
            signal = &mut shutdown => {
                signal?;
                stop_child(&mut backend).await;
                return Ok(());
            }
            status = backend.wait() => return check_exit("backend", status?),
            result = TcpStream::connect(("127.0.0.1", 8080)) => {
                if result.is_ok() {
                    break;
                }
            }
            _ = sleep(Duration::from_millis(100)) => {}
        }
    }

    let mut frontend = if with_frontend {
        match Command::new("mise")
            .args(["run", "frontend-dev"])
            .current_dir(project_dir)
            .stdin(Stdio::inherit())
            .stdout(Stdio::inherit())
            .stderr(Stdio::inherit())
            .spawn()
        {
            Ok(frontend) => Some(frontend),
            Err(error) => {
                stop_child(&mut backend).await;
                return Err(error.into());
            }
        }
    } else {
        None
    };

    if let Some(frontend) = frontend.as_mut() {
        enum Exit {
            Shutdown,
            Backend(ExitStatus),
            Frontend(ExitStatus),
        }

        let exit = tokio::select! {
            biased;
            signal = &mut shutdown => {
                signal?;
                Exit::Shutdown
            }
            status = backend.wait() => Exit::Backend(status?),
            status = frontend.wait() => Exit::Frontend(status?),
        };

        match exit {
            Exit::Shutdown => {
                stop_child(&mut backend).await;
                stop_child(frontend).await;
                Ok(())
            }
            Exit::Backend(status) => {
                stop_child(frontend).await;
                check_exit("backend", status)
            }
            Exit::Frontend(status) => {
                stop_child(&mut backend).await;
                check_exit("frontend", status)
            }
        }
    } else {
        let exit = tokio::select! {
            biased;
            signal = &mut shutdown => {
                signal?;
                stop_child(&mut backend).await;
                return Ok(());
            }
            status = backend.wait() => status?,
        };
        check_exit("backend", exit)
    }
}

async fn backend_executable(
    project_dir: &Path, package_name: &str,
) -> Result<PathBuf, Box<dyn Error>> {
    let metadata_output = Command::new("cargo")
        .args(["metadata", "--no-deps", "--format-version", "1"])
        .current_dir(project_dir)
        .output()
        .await?;
    if !metadata_output.status.success() {
        return Err("cargo metadata failed".into());
    }

    let metadata: serde_json::Value = serde_json::from_slice(&metadata_output.stdout)?;
    let target_directory = metadata["target_directory"]
        .as_str()
        .ok_or_else(|| std::io::Error::other("cargo metadata omitted target_directory"))?;
    let executable_name = metadata["packages"]
        .as_array()
        .into_iter()
        .flatten()
        .find(|package| package["name"].as_str() == Some(package_name))
        .and_then(|package| package["targets"].as_array())
        .and_then(|targets| {
            targets.iter().find(|target| {
                target["name"].as_str() == Some(package_name)
                    && target["kind"]
                        .as_array()
                        .is_some_and(|kinds| kinds.iter().any(|kind| kind == "bin"))
            })
        })
        .and_then(|target| target["name"].as_str())
        .ok_or_else(|| std::io::Error::other("Cargo package has no matching binary target"))?;

    let mut executable = PathBuf::from(target_directory).join("debug").join(executable_name);
    if cfg!(windows) {
        executable.set_extension("exe");
    }
    Ok(executable)
}

async fn stop_child(child: &mut Child) {
    if child.try_wait().ok().flatten().is_none() {
        let _ = child.kill().await;
    }
    let _ = child.wait().await;
}

fn check_exit(process: &str, status: ExitStatus) -> Result<(), Box<dyn Error>> {
    if status.code().is_some_and(|code| code != 0) {
        return Err(format!("{process} exited with {status}").into());
    }
    Ok(())
}
