// ============================================================================
// RLS tenant isolation tests
// ============================================================================

mod rls_isolation {
    use super::*;
    use e2e::{base_url{% if authentication == 'jwt' %}, authed_http_client{% else %}, http_client{% endif %}};
    use rstest::rstest;

    /// Helper: create a {{ ns.rls_entity_name }} under a specific tenant.
    async fn create_as_tenant(client: &reqwest::Client, base_url: &str, tenant: &str, suffix: &str) -> Value {
        let body = json!({
{% for attr_name, attr_prop in ns.rls_entity.attributes | items -%}
{% if not attr_prop.readOnly and attr_prop.type != 'relation' -%}
{% if attr_prop.type == 'string' -%}
{% if attr_prop.format == 'email' -%}
            "{{ attr_name | snake_case }}": format!("rls_{}@example.com", suffix),
{% else -%}
            "{{ attr_name | snake_case }}": format!("rls_test_{}_{}", "{{ attr_name | snake_case }}", suffix),
{% endif -%}
{% elif attr_prop.type == 'integer' -%}
            "{{ attr_name | snake_case }}": {{ attr_prop.default | default(1) }},
{% elif attr_prop.type == 'boolean' -%}
            "{{ attr_name | snake_case }}": {{ attr_prop.default | default('true') | lower }},
{% elif attr_prop.type == 'text' -%}
            "{{ attr_name | snake_case }}": format!("rls test {} content", suffix),
{% elif attr_prop.type == 'enumeration' or attr_prop.enum -%}
            "{{ attr_name | snake_case }}": "{{ attr_prop.enum[0] | default('default') }}",
{% endif -%}
{% endif -%}
{% endfor -%}
        });
        api_post_tenant(client, &format!("{}/api/{{ rls_plural }}", base_url), &body, tenant).await
    }

    /// Helper: list all {{ ns.rls_entity_name }} visible to a specific tenant.
    async fn list_as_tenant(client: &reqwest::Client, base_url: &str, tenant: &str) -> Vec<Value> {
        let resp = client
            .get(format!("{}/api/{{ rls_plural }}", base_url))
            .header("X-Tenant-Id", tenant)
            .send().await
            .expect("GET {{ rls_plural }} failed");
        assert!(resp.status().is_success(), "list as {} failed: {}", tenant, resp.status());
        let body: Value = resp.json().await.expect("parse list body");
        if let Some(arr) = body.as_array() { arr.clone() }
        else if let Some(arr) = body["data"].as_array() { arr.clone() }
        else { panic!("unexpected list shape: {:?}", body) }
    }

    /// Tenant A's data must be invisible to Tenant B.
    #[rstest]
    #[tokio::test]
    async fn tenant_isolation_list(#[future] base_url: String, {% if authentication == 'jwt' %}#[future] authed_http_client: reqwest::Client{% else %}http_client: reqwest::Client{% endif %}) {
        let base_url = base_url.await;
        {% if authentication == 'jwt' %}let http_client = authed_http_client.await;{% endif %}

        create_as_tenant(&http_client, &base_url, "tenant-a", "iso_a").await;

        let list_b = list_as_tenant(&http_client, &base_url, "tenant-b").await;
        for item in &list_b {
            assert_ne!(
