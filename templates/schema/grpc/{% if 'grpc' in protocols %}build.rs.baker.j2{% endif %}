{% if backend == 'axum' -%}
fn main() -> Result<(), Box<dyn std::error::Error>> {
    println!("cargo:rerun-if-changed=proto");
    // protox compiles the proto in pure Rust, so no system protoc is required.
    let descriptors = protox::compile(["{{ project_name | snake_case }}.proto"], ["proto"])?;
    tonic_prost_build::configure()
        .build_client(false)
        .compile_fds(descriptors)?;
    Ok(())
}
{% else -%}
fn main() {
    if std::env::var_os("GRPC_RUST_REGENERATE_PROTO").is_some() {
        let manifest_dir = std::path::PathBuf::from(
            std::env::var("CARGO_MANIFEST_DIR").unwrap(),
        );
        grpc_protobuf_build::CodeGen::new()
            .output_dir(manifest_dir.join("src/gen"))
            .input("{{ project_name | snake_case }}.proto")
            .include(manifest_dir.join("proto"))
            .client_only()
            .compile()
            .unwrap();
    }
}
{% endif -%}

