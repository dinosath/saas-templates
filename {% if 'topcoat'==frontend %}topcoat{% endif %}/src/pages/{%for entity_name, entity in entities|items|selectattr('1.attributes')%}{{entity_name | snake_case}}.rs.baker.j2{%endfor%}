use topcoat::prelude::*;
use crate::components::layout;

{% set display_name = entity.info.displayName | default(entity_name) %}

#[page("/{{ entity_name | snake_case }}")]
pub async fn list_{{ entity_name | snake_case }}() -> Result {
    view! {
        layout::layout(title: "{{ display_name }}") {
            <div>
                <div class="mb-6 flex items-center justify-between">
                    <h1 class="text-2xl font-bold text-gray-900">"{{ display_name }}"</h1>
                </div>
                <div class="overflow-hidden rounded-lg border bg-white shadow">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">"ID"</th>
                                {% for name, property in entity.attributes | items %}
                                {% if not property.writeOnly and not macros.relation_is_many_to_many(property)=='true' and not macros.relation_is_one_to_many(property)=='true' %}
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">"{{ name | replace('_', ' ') | title }}"</th>
                                {% endif %}
                                {% endfor %}
                                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">"Actions"</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            <tr>
                                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500" colspan="100%">"Loading {{ display_name | lower }}..."</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

#[page("/{{ entity_name | snake_case }}/:id")]
pub async fn show_{{ entity_name | snake_case }}(id: String) -> Result {
    view! {
        layout::layout(title: "{{ display_name }} Details") {
            <div>
                <div class="mb-6">
                    <a href="/{{ entity_name | snake_case }}" class="text-sm text-indigo-600 hover:text-indigo-800">"&larr; Back to {{ display_name }}"</a>
                </div>
                <div class="rounded-lg border bg-white p-6 shadow">
                    <h1 class="mb-4 text-xl font-bold text-gray-900">{{ display_name }} " Detail"</h1>
                    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">"ID"</dt>
                            <dd class="mt-1 text-sm text-gray-900">(id)</dd>
                        </div>
                        {% for name, property in entity.attributes | items %}
                        {% if not property.writeOnly and not macros.relation_is_many_to_many(property)=='true' and not macros.relation_is_one_to_many(property)=='true' %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">"{{ name | replace('_', ' ') | title }}"</dt>
                            <dd class="mt-1 text-sm text-gray-900">"—"</dd>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </dl>
                </div>
            </div>
        }
    }
}
