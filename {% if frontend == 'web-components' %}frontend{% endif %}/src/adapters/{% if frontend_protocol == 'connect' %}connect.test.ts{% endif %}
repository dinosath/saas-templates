import { afterEach, expect, it, vi } from 'vitest';
import { createConnectEntityTransport } from './connect';
import { createEntityClient, EntityClientError } from '../core/client';

afterEach(() => vi.unstubAllGlobals());

it('uses the official Connect transport and forwards caller headers', async () => {
  const requestFetch = vi.fn<typeof fetch>().mockResolvedValue(new Response(JSON.stringify({ bodyJson: '[{"id":7}]', total: '1' }), {
    headers: { 'content-type': 'application/json' },
  }));
  vi.stubGlobal('fetch', requestFetch);
  const transport = createConnectEntityTransport({ baseUrl: 'https://example.test', headers: () => ({ authorization: 'Bearer test', 'x-tenant-id': 'tenant-a' }) });
  expect(await createEntityClient(transport).list('Document')).toEqual({ records: [{ id: 7 }], total: 1 });
  expect(String(requestFetch.mock.calls[0][0])).toBe('https://example.test/entities.v1.EntityService/Execute');
  const headers = new Headers(requestFetch.mock.calls[0][1]?.headers);
  expect(headers.get('x-tenant-id')).toBe('tenant-a');
  expect(headers.get('authorization')).toBe('Bearer test');
});

it('normalizes Connect errors into the vendor-neutral error type', async () => {
  vi.stubGlobal('fetch', vi.fn<typeof fetch>().mockResolvedValue(new Response(JSON.stringify({ code: 'permission_denied', message: 'Not allowed' }), {
    status: 403, headers: { 'content-type': 'application/json' },
  })));
  const client = createEntityClient(createConnectEntityTransport({ baseUrl: 'https://example.test' }));
  await expect(client.read('Document', 7)).rejects.toBeInstanceOf(EntityClientError);
});